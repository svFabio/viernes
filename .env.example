# ==============================================================================
# Viernes Voice Assistant - Environment Variables
# Copy this file to .env and configure your secrets locally.
# DO NOT commit your .env file containing real API keys to version control.
# ==============================================================================

# [ElevenLabs Cloud TTS]
# API key from https://elevenlabs.io (optional; if empty, system falls back to local Piper)
ELEVENLABS_API_KEY=

# Voice ID to use for neural speech synthesis (default: Rachel voice ID)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# [Piper Local TTS Fallback]
# Path or binary name for the Piper offline neural TTS engine
PIPER_BIN=piper

# Path to the Piper ONNX voice model file (e.g. /home/user/models/es_ES-davefx-medium.onnx)
PIPER_MODEL_PATH=

# [System & Audio Paths]
# Directory used for intermediate audio chunks and synthesized files
VIERNES_TEMP_DIR=/tmp/viernes
